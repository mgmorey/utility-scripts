abort() {
    printf "$@" >&2
    exit 1
}

abort_not_supported() {
    abort '%s: %s: %s not supported\n' "$0" "$PRETTY_NAME" "$*"
}

assert() {
    "$@" || abort '%s: Assertion failed: %s\n' "$0" "$*"
}

# Print the existing files for the first ID or ID_LIKE entry that has any, from
# the least specific (OS) to the most specific (OS and release); later files
# override earlier ones.  Only ID may match without a release, since a release
# of a similar OS need not correspond to the release of this one.
get_configuration_files() {
    stems=true

    for id in $ID $ID_LIKE; do
	stem=$(get_configuration_stem "$id")
	version=$(get_configuration_version "$id")
	files=

	for name in ${stems:+$stem} ${version:+$stem-${version%%[.-]*} $stem-$version}; do
	    path="$script_prefix$(printf '%s\n' "$name.ini" | to_lower)"

	    if [ -r "$path" ]; then
		case " $files " in
		    (*" $path "*)
			;;
		    (*)
			files="${files:+$files }$path"
			;;
		esac
	    fi
	done

	if [ -n "$files" ]; then
	    printf '%s\n' "$files"
	    return
	fi

	stems=
    done
}

get_configuration_stem() {
    case "$1" in
	(windows)
	    printf '%s-%s\n' "${kernel_name%_*}" "$1"
	    ;;
	(*)
	    printf '%s\n' "$1"
	    ;;
    esac
}

get_configuration_version() {
    case "$1" in
	(opensuse-tumbleweed)
	    ;;
	(freebsd)
	    printf '%s\n' "${VERSION_ID%-p*}"
	    ;;
	(macos)
	    printf '%s\n' "$VERSION_ID" | cut -d. -f 1,2
	    ;;
	(windows)
	    printf '%s\n' "${VERSION_ID%.0}"
	    ;;
	(*)
	    printf '%s\n' "$VERSION_ID"
	    ;;
    esac
}

get_os_configuration() {
    files=$(get_configuration_files)

    if [ -n "$files" ]; then
	"${script_prefix}get-configuration" --extended $files
    else
	abort_not_supported "Operating system"
    fi
}

parse_arguments() {
    while getopts i:l:v:h opt; do
	case $opt in
	    (i)
		ID="$OPTARG"
		;;
	    (l)
		ID_LIKE="$OPTARG"
		;;
	    (v)
		VERSION_ID="$OPTARG"
		;;
	    (h)
		usage
		exit 0
		;;
	    (\?)
		exit 2
		;;
	esac
    done

    shift $(($OPTIND - 1))
}

to_lower() {
    tr '[:upper:]' '[:lower:]'
}

usage() {
    cat <<EOF >&2
Usage: $0 [-i ID] [-l ID_LIKE] [-v VERSION_ID]
       $0 -h
EOF
}

usage_error() {
    if [ $# -gt 0 ]; then
	printf "$@" >&2
    fi

    printf '%s\n' '' >&2
    usage
    exit 2
}

case "$0" in
    (*/*)
	script_dir=$(cd "$(dirname "$0")" && pwd)
	;;
    (*)
	script_dir=
	;;
esac

script_prefix=${script_dir:+$script_dir/}

eval "$("${script_prefix}get-os-release" -x)"
parse_arguments "$@"
get_os_configuration
