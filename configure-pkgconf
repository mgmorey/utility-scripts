GNU_ARCHIVE_DIR="$HOME/Downloads/GNU"

PKGCONF_ARCHIVE_SHA256=3a9080ac51d03615e7c1910a0a2a8df08424892b5f13b0628a204d3fcce0ea8b
PKGCONF_ARCHIVE_SUFFIX=.tar.xz
PKGCONF_MIRROR_BASE_URL=${PKGCONF_MIRROR_BASE_URL:-https://distfiles.ariadne.space}
PKGCONF_PROJECT_NAME=pkgconf
PKGCONF_PROJECT_VERSION=3.0.11

abort() {
    printf "$@" >&2
    exit 1
}

abort_invalid_prefix() {
    usage_error '%s: invalid prefix -- %s\n' "$script" "$*"
}

abort_invalid_version() {
    usage_error '%s: invalid version -- %s\n' "$script" "$*"
}

abort_not_supported() {
    abort '%s: %s: %s not supported\n' "$script" "$PRETTY_NAME" "$*"
}

assert() {
    "$@" || abort '%s: Assertion failed: %s\n' "$script" "$*"
}

configure_pkgconf() {
    umask 0022

    if [ "$force" = true ]; then
	rm -rf "$build_dirname" "$src_dirname" "$archive_pathname"
    fi

    mkdir -p "$build_dirname" "$src_dirname" "$archive_dirname"
    download_archive "$archive_pathname" "$archive_url"

    # pkgconf publishes no signature; the checksum covers the default version
    if [ "$version" = "$PKGCONF_PROJECT_VERSION" ]; then
	verify_checksum "$archive_pathname" "$PKGCONF_ARCHIVE_SHA256"
    fi

    extract_archive "$archive_pathname" "$src_dirname"
    cd "$build_dirname"

    command=$(get_pkgconf_configure_command $src_dirname)
    printf '%s\n' "$command"
    eval $command

    if [ "$build" = true ]; then
	make_build
    fi

    if [ "$check" = true ]; then
	make_check "check"
    fi
}

configure_paths() {
    archive_dirname="$GNU_ARCHIVE_DIR"
    archive_basename=$PKGCONF_PROJECT_NAME-$version
    build_dirname="$HOME/Documents/build/$archive_basename"
    archive_filename=$archive_basename$PKGCONF_ARCHIVE_SUFFIX
    archive_pathname="$GNU_ARCHIVE_DIR/$archive_filename"
    src_dirname="$HOME/Documents/src/GNU/$archive_basename"
    archive_url=$PKGCONF_MIRROR_BASE_URL/$PKGCONF_PROJECT_NAME/$archive_filename
}

get_configure_options() (
    if [ -n "${prefix-}" ]; then
        options="${options:+$options }--prefix=$(get_prefix)"
    fi

    options="${options:+$options }--with-pkg-config-dir=$(get_pkg_config_dirs)"
    options="${options:+$options }--with-system-libdir=$(get_system_libdirs)"
    options="${options:+$options }--with-system-includedir=/usr/include"

    if [ -n "${options:-}" ]; then
	printf '%s\n' "$options"
    fi
)

get_dependencies() {
    get-packages $PKGCONF_PROJECT_NAME-build $PKGCONF_PROJECT_NAME-test
}

get_pkgconf_configure_command() {
    options=$(get_configure_options)
    printf '%s' "$1/${2-configure}"

    if [ -n "${options-}" ]; then
	printf ' %s' "$options"
    fi

    printf '\n'
}

get_prefix() {
    printf "$prefix" "$PKGCONF_PROJECT_NAME-$version"
}

# Search the installation prefix first, then the system's directories
get_pkg_config_dirs() (
    dirs="$(get_prefix)/lib64/pkgconfig:$(get_prefix)/lib/pkgconfig"
    dirs="$dirs:$(get_prefix)/share/pkgconfig"
    multiarch=$(cc -print-multiarch 2>/dev/null || true)

    for dir in /usr/local/lib/pkgconfig /usr/local/share/pkgconfig \
					${multiarch:+/usr/lib/$multiarch/pkgconfig} \
					/usr/lib64/pkgconfig /usr/lib/pkgconfig /usr/share/pkgconfig; do
	if [ -d "$dir" ]; then
	    dirs="$dirs:$dir"
	fi
    done

    printf '%s\n' "$dirs"
)

get_system_libdirs() (
    multiarch=$(cc -print-multiarch 2>/dev/null || true)

    for dir in /lib ${multiarch:+/lib/$multiarch} /lib64 \
		    /usr/lib ${multiarch:+/usr/lib/$multiarch} /usr/lib64; do
	if [ -d "$dir" ]; then
	    dirs="${dirs:+$dirs:}$dir"
	fi
    done

    printf '%s\n' "$dirs"
)

install_pkgconf() {
    if [ "$install" != true ]; then
	return 0
    fi

    install_prefix=$(get_prefix)

    if [ "$ID" != windows -a "$(id -u)" -gt 0 -a ! -w "$install_prefix" ]; then
	return 0
    fi

    umask 0022
    cd "$build_dirname"
    make_install prefix="$install_prefix" install
    ln -sf pkgconf "$install_prefix/bin/pkg-config"
    install_project_link "$install_prefix"
}

parse_arguments() {
    build=true
    check=false
    force=false
    install=false
    keep=false
    prefix=$GNU_OPT_PREFIX
    version=$PKGCONF_PROJECT_VERSION

    while getopts bcfiknp:v:h opt; do
	case $opt in
	    (b)
		build=true
		;;
	    (c)
		check=true
		;;
	    (f)
		build=true
		force=true
		;;
	    (i)
		install=true
		;;
	    (k)
		keep=true
		;;
	    (n)
		build=false
		force=false
		;;
	    (p)
		case $OPTARG in
		    ($HOME/.local|$LOCAL_PREFIX|$GNU_OPT_PREFIX|/*)
			prefix=$OPTARG
			;;
		    (*)
			abort_invalid_prefix $OPTARG
			;;
		esac
		;;
	    (v)
		case $OPTARG in
		    ([1-9].[0-9].[0-9]|[1-9].[0-9].[1-9][0-9])
			version=$OPTARG
			;;
		    (*)
			abort_invalid_version $OPTARG
			;;
		esac
		;;
	    (h)
		usage
		exit 0
		;;
	    (\?)
		exit 2
		;;
	esac
    done

    shift $(($OPTIND - 1))

    if [ $# -gt 0 ]; then
	usage_error '%s: Too many arguments\n' "$script"
    fi
}

usage() {
    cat <<EOF >&2
Usage: $script [-b] [-c] [-f] [-i] [-k] [-n] [-p PREFIX] [-v VERSION]
       $script -h
EOF
}

usage_error() {
    if [ $# -gt 0 ]; then
	printf "$@" >&2
    fi

    printf '%s\n' '' >&2
    usage
    exit 2
}

validate_platform() {
    case "$ID" in
	(centos)
	    case "$VERSION_ID" in
		(7)
		    return
		    ;;
		(8)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(debian|raspbian)
	    return
	    ;;
	(fedora)
	    return
	    ;;
	(opensuse-*)
	    return
	    ;;
	(rhel|ol|almalinux)
	    case "$VERSION_ID" in
		(7.*)
		    return
		    ;;
		(8.*)
		    return
		    ;;
		(9.*)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(rocky)
	    case "$VERSION_ID" in
		(7.*)
		    return
		    ;;
		(8.*)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(ubuntu)
	    return
	    ;;
	(freebsd)
	    return
	    ;;
	(illumos)
	    return
	    ;;
	(macos)
	    return
	    ;;
	(netbsd)
	    return
	    ;;
	(solaris)
	    return
	    ;;
	(windows)
	    return
	    ;;
	(*)
	    abort_not_supported "Operating system"
	    ;;
    esac
}

script=$(basename "$0")

case "$0" in
    (*/*)
	script_dir=$(cd "$(dirname "$0")" && pwd)
	;;
    (*)
	script_dir=
	;;
esac

script_prefix=${script_dir:+$script_dir/}

. "${script_prefix}common-functions.sh"
. "${script_prefix}config-functions.sh"

set_user_profile "$script_dir"
eval "$(get-os-release -x)"
validate_platform
configure_platform
parse_arguments "$@"
configure_paths

if [ "$keep" != true ]; then
    install_dependencies
fi

if [ "$(id -u)" -eq 0 ]; then
    run_unpriv /bin/sh -c "$0 $*"
else
    configure_pkgconf
fi

install_pkgconf
