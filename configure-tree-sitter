TREE_SITTER_ARCHIVE_DIR="$HOME/Downloads/TreeSitter"
TREE_SITTER_ARCHIVE_SUFFIX=.tar.gz

TREE_SITTER_BASE_URL=https://github.com/tree-sitter/tree-sitter
TREE_SITTER_PROJECT_NAME=tree-sitter
TREE_SITTER_PROJECT_VERSION=0.27.2

abort() {
    printf "$@" >&2
    exit 1
}

abort_invalid_prefix() {
    usage_error '%s: invalid prefix -- %s\n' "$script" "$*"
}

abort_invalid_version() {
    usage_error '%s: invalid version -- %s\n' "$script" "$*"
}

abort_not_supported() {
    abort '%s: %s: %s not supported\n' "$script" "$PRETTY_NAME" "$*"
}

assert() {
    "$@" || abort '%s: Assertion failed: %s\n' "$script" "$*"
}

configure_paths() {
    archive_dirname="$TREE_SITTER_ARCHIVE_DIR"
    archive_basename=$TREE_SITTER_PROJECT_NAME-$version
    src_dirname="$HOME/Documents/src/TreeSitter/$archive_basename"
    archive_filename=$archive_basename$TREE_SITTER_ARCHIVE_SUFFIX
    archive_pathname="$TREE_SITTER_ARCHIVE_DIR/$archive_filename"
    archive_url=$TREE_SITTER_BASE_URL/archive/refs/tags/v$version.tar.gz
}

configure_tree_sitter() {
    umask 0022

    if [ "$force" = true ]; then
	rm -rf "$src_dirname" "$archive_pathname"
    fi

    mkdir -p "$archive_dirname" "$src_dirname"
    download_archive "$archive_pathname" "$archive_url"
    extract_archive "$archive_pathname" "$src_dirname"

    # There is no configure script; the prefix is built into tree-sitter.pc
    cd "$src_dirname"

    if [ "$build" = true ]; then
	$make clean
	make_build PREFIX="$(get_prefix)" ${cc:+"CC=$cc"}
    fi

    if [ "$check" = true ]; then
	printf '%s: no tests to run without the Tree-sitter CLI\n' "$script" >&2
    fi
}

get_dependencies() {
    get-packages bootstrap tree-sitter-build
}

get_prefix() {
    printf "$prefix" "$TREE_SITTER_PROJECT_NAME-$version"
}

install_tree_sitter() {
    if [ "$install" != true ]; then
	return 0
    fi

    install_prefix=$(get_prefix)

    if [ "$ID" != windows -a "$(id -u)" -gt 0 -a ! -w "$install_prefix" ]; then
	return 0
    fi

    umask 0022
    cd "$src_dirname"
    make_install PREFIX="$install_prefix" install
    install_project_link "$install_prefix"
}

parse_arguments() {
    build=true
    check=false
    force=false
    install=false
    keep=false
    prefix=$GNU_OPT_PREFIX
    version=$TREE_SITTER_PROJECT_VERSION

    while getopts bcfiknp:v:h opt; do
	case $opt in
	    (b)
		build=true
		;;
	    (c)
		check=true
		;;
	    (f)
		build=true
		force=true
		;;
	    (i)
		install=true
		;;
	    (k)
		keep=true
		;;
	    (n)
		build=false
		force=false
		;;
	    (p)
		case $OPTARG in
		    ($HOME/.local|$LOCAL_PREFIX|$GNU_OPT_PREFIX|/*)
			prefix=$OPTARG
			;;
		    (*)
			abort_invalid_prefix $OPTARG
			;;
		esac
		;;
	    (v)
		case $OPTARG in
		    ([0-9].[0-9].[0-9]|[0-9].[0-9][0-9].[0-9]|[0-9].[0-9][0-9].[0-9][0-9])
			version=$OPTARG
			;;
		    (*)
			abort_invalid_version $OPTARG
			;;
		esac
		;;
	    (h)
		usage
		exit 0
		;;
	    (\?)
		exit 2
		;;
	esac
    done

    shift $(($OPTIND - 1))

    if [ $# -gt 0 ]; then
	usage_error '%s: Too many arguments\n' "$script"
    fi
}

usage() {
    cat <<EOF >&2
Usage: $script [-b] [-c] [-f] [-i] [-k] [-n] [-p PREFIX] [-v VERSION]
       $script -h
EOF
}

usage_error() {
    if [ $# -gt 0 ]; then
	printf "$@" >&2
    fi

    printf '%s\n' '' >&2
    usage
    exit 2
}

validate_platform() {
    case "$ID" in
	(centos)
	    case "$VERSION_ID" in
		(7)
		    return
		    ;;
		(8)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(debian|raspbian)
	    return
	    ;;
	(fedora)
	    return
	    ;;
	(opensuse-*)
	    return
	    ;;
	(rhel|ol|almalinux|rocky)
	    case "$VERSION_ID" in
		(7.*)
		    return
		    ;;
		(8.*)
		    return
		    ;;
		(9.*)
		    return
		    ;;
		(10.*)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(ubuntu)
	    return
	    ;;
	(freebsd)
	    return
	    ;;
	(illumos)
	    return
	    ;;
	(macos)
	    return
	    ;;
	(netbsd)
	    return
	    ;;
	(solaris)
	    return
	    ;;
	(*)
	    abort_not_supported "Operating system"
	    ;;
    esac
}

script=$(basename "$0")

case "$0" in
    (*/*)
	script_dir=$(cd "$(dirname "$0")" && pwd)
	;;
    (*)
	script_dir=
	;;
esac

script_prefix=${script_dir:+$script_dir/}

. "${script_prefix}common-functions.sh"
. "${script_prefix}config-functions.sh"

set_user_profile "$script_dir"
eval "$(get-os-release -x)"
validate_platform
configure_platform
parse_arguments "$@"
configure_paths

if [ "$keep" != true ]; then
    install_dependencies
fi

if [ "$(id -u)" -eq 0 ]; then
    run_unpriv /bin/sh -c "$0 $*"
else
    configure_tree_sitter
fi

install_tree_sitter
