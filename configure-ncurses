GNU_ARCHIVE_DIR="$HOME/Downloads/GNU"

NCURSES_ARCHIVE_SUFFIX=.tar.gz
NCURSES_PROJECT_NAME=ncurses
NCURSES_PROJECT_VERSION=6.6

abort() {
    printf "$@" >&2
    exit 1
}

abort_invalid_prefix() {
    usage_error '%s: invalid prefix -- %s\n' "$script" "$*"
}

abort_invalid_version() {
    usage_error '%s: invalid version -- %s\n' "$script" "$*"
}

abort_not_supported() {
    abort '%s: %s: %s not supported\n' "$script" "$PRETTY_NAME" "$*"
}

assert() {
    "$@" || abort '%s: Assertion failed: %s\n' "$script" "$*"
}

configure_ncurses() {
    umask 0022

    if [ "$force" = true ]; then
	rm -rf "$build_dirname" "$src_dirname" "$archive_pathname"
    fi

    mkdir -p "$build_dirname" "$src_dirname" "$archive_dirname"
    download_archive "$archive_pathname" "$archive_url"
    extract_archive "$archive_pathname" "$src_dirname"
    cd "$build_dirname"

    command=$(get_configure_command "$src_dirname")
    printf '%s\n' "$command"
    eval "$command"

    if [ "$build" = true ]; then
	make_build
    fi

    if [ "$check" = true ]; then
	make_check "check"
    fi
}

configure_paths() {
    if [ "$widec" = true ]; then
	build_suffix=-widec
    fi

    archive_dirname="$GNU_ARCHIVE_DIR"
    archive_basename=$NCURSES_PROJECT_NAME-$version
    build_dirname="$HOME/Documents/build/$archive_basename${build_suffix-}"
    archive_filename=$archive_basename$NCURSES_ARCHIVE_SUFFIX
    archive_pathname="$GNU_ARCHIVE_DIR/$archive_filename"
    src_dirname="$HOME/Documents/src/GNU/$archive_basename"
    archive_url=$GNU_MIRROR_BASE_URL/$NCURSES_PROJECT_NAME/$archive_filename
}

get_configure_options() (
    if [ -n "${prefix-}" ]; then
        options="${options:+$options }--prefix=$(get_prefix)"
	options="${options:+$options }--enable-pc-files"
	options="${options:+$options }--with-pkg-config-libdir=$(get_prefix)/lib/pkgconfig"
	terminfo_dirs=$(get_prefix)/share/terminfo:
    fi

    # Shared and static libraries, so that readline and Emacs can link either
    for option in --with-shared --with-normal --with-termlib --enable-rpath \
		  --without-ada --without-cxx-binding --without-debug \
		  --without-manpages --without-progs --without-tests; do
	options="${options:+$options }$option"
    done

    if [ "$widec" = true ]; then
	options="${options:+$options }--enable-widec"
    else
	options="${options:+$options }--disable-widec"
    fi

    # A private prefix would otherwise look only in its own terminfo directory
    options="${options:+$options }--with-terminfo-dirs=${terminfo_dirs-}/etc/terminfo:/lib/terminfo:/usr/share/terminfo"

    if [ -n "${options:-}" ]; then
	printf '%s\n' "$options"
    fi
)

get_dependencies() {
    get-packages $NCURSES_PROJECT_NAME-build $NCURSES_PROJECT_NAME-test
}

get_prefix() {
    printf "$prefix" "$NCURSES_PROJECT_NAME-$version"
}

install_ncurses() {
    if [ "$install" != true ]; then
	return 0
    fi

    install_prefix=$(get_prefix)

    if [ "$ID" != windows -a "$(id -u)" -gt 0 -a ! -w "$install_prefix" ]; then
	return 0
    fi

    umask 0022
    cd "$build_dirname"

    # The system tic compiles terminfo and must not load the new libtinfo.
    (unset LD_LIBRARY_PATH; make_install prefix="$install_prefix" install)
    install_project_link "$install_prefix"
}

parse_arguments() {
    build=true
    check=false
    force=false
    install=false
    keep=false
    prefix=$GNU_OPT_PREFIX
    version=$NCURSES_PROJECT_VERSION
    widec=false

    while getopts bcfiknp:v:wh opt; do
	case $opt in
	    (b)
		build=true
		;;
	    (c)
		check=true
		;;
	    (f)
		build=true
		force=true
		;;
	    (i)
		install=true
		;;
	    (k)
		keep=true
		;;
	    (n)
		build=false
		force=false
		;;
	    (p)
		case $OPTARG in
		    ($HOME/.local|$LOCAL_PREFIX|$GNU_OPT_PREFIX|/*)
			prefix=$OPTARG
			;;
		    (*)
			abort_invalid_prefix $OPTARG
			;;
		esac
		;;
	    (v)
		case $OPTARG in
		    ([5-9].[0-9]|[5-9].[1-9][0-9])
			version=$OPTARG
			;;
		    (*)
			abort_invalid_version $OPTARG
			;;
		esac
		;;
	    (w)
		widec=true
		;;
	    (h)
		usage
		exit 0
		;;
	    (\?)
		exit 2
		;;
	esac
    done

    shift $(($OPTIND - 1))

    if [ $# -gt 0 ]; then
	usage_error '%s: Too many arguments\n' "$script"
    fi
}

usage() {
    cat <<EOF >&2
Usage: $script [-b] [-c] [-f] [-i] [-k] [-n] [-p PREFIX] [-v VERSION] [-w]
       $script -h
EOF
}

usage_error() {
    if [ $# -gt 0 ]; then
	printf "$@" >&2
    fi

    printf '%s\n' '' >&2
    usage
    exit 2
}

validate_platform() {
    case "$ID" in
	(centos)
	    case "$VERSION_ID" in
		(7)
		    return
		    ;;
		(8)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(debian|raspbian)
	    return
	    ;;
	(fedora)
	    return
	    ;;
	(opensuse-*)
	    return
	    ;;
	(rhel|ol|almalinux|rocky)
	    case "$VERSION_ID" in
		(7.*)
		    return
		    ;;
		(8.*)
		    return
		    ;;
		(9.*)
		    return
		    ;;
		(10.*)
		    return
		    ;;
		(*)
		    abort_not_supported Release
		    ;;
	    esac
	    ;;
	(ubuntu)
	    return
	    ;;
	(freebsd)
	    return
	    ;;
	(illumos)
	    return
	    ;;
	(macos)
	    return
	    ;;
	(netbsd)
	    return
	    ;;
	(solaris)
	    return
	    ;;
	(windows)
	    return
	    ;;
	(*)
	    abort_not_supported "Operating system"
	    ;;
    esac
}

script=$(basename "$0")

case "$0" in
    (*/*)
	script_dir=$(cd "$(dirname "$0")" && pwd)
	;;
    (*)
	script_dir=
	;;
esac

script_prefix=${script_dir:+$script_dir/}

. "${script_prefix}common-functions.sh"
. "${script_prefix}config-functions.sh"

set_user_profile "$script_dir"
eval "$(get-os-release -x)"
validate_platform
configure_platform
parse_arguments "$@"
configure_paths

if [ "$keep" != true ]; then
    install_dependencies
fi

if [ "$(id -u)" -eq 0 ]; then
    run_unpriv /bin/sh -c "$0 $*"
else
    configure_ncurses
fi

install_ncurses
