abort() {
    printf "$@" >&2
    exit 1
}

assert() {
    "$@" || abort '%s: Assertion failed: %s\n' "$script" "$*"
}

# Unlike print_parameter(), an emptied value must still be printed
print_value() {
    case "$(basename "${shell%.exe}")" in
	(*bash|ksh*|zsh)
	    printf 'export %s=%s\n' "$var" "$(quote_value "$value")"
	    ;;
	(csh|tcsh)
	    printf 'setenv %s %s;\n' "$var" "$(quote_value "$value")"
	    ;;
	(fish)
	    printf 'set -x %s %s;\n' "$var" "$(quote_fish_value "$value")"
	    ;;
	(*)
	    printf '%s=%s\n' "$var" "$(quote_value "$value")"
	    printf 'export %s\n' "$var"
	    ;;
    esac
}

remove_from_path() {
    shell=$SHELL

    while getopts s:h opt; do
	case $opt in
	    (s)
		parse_shell "$OPTARG"
		;;
	    (h)
		usage
		exit 0
		;;
	    (\?)
		exit 2
		;;
	esac
    done

    shift $(($OPTIND - 1))

    if [ $# -lt 2 ]; then
	usage_error '%s: Not enough arguments\n' "$script"
    fi

    var="$1"
    shift

    eval value="\${$var-}"

    for dir; do
	value=$(remove_directory "$dir" "$value")
    done

    print_value
}

usage() {
    cat <<-EOF >&2
Usage: $script: [-s SHELL] PARAMETER [DIRECTORY [...]]
       $script: -h
EOF
}

script=$(basename "$0")

case "$0" in
    (*/*)
	script_dir=$(cd "$(dirname "$0")" && pwd)
	;;
    (*)
	script_dir=
	;;
esac

script_prefix=${script_dir:+$script_dir/}

. "${script_prefix}parameter-functions.sh"

remove_from_path "$@"
